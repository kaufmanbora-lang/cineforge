# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
APP_ENCRYPTION_KEY=replace-with-64-hex-characters
DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000001

# OpenAI — server-side only
OPENAI_API_KEY=
OPENAI_SCREENWRITER_MODEL=gpt-5.6-sol
OPENAI_PROMPT_MODEL=gpt-5.6-terra
OPENAI_QC_MODEL=gpt-5.6-luna

# Google Gemini — server-side fallback; Settings → API stores an encrypted per-workspace key
GEMINI_API_KEY=

# PostgreSQL / Redis
DATABASE_URL=postgresql://cineforge:cineforge@localhost:5432/cineforge
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO defaults below)
S3_ENDPOINT=http://localhost:9000
# Optional public endpoint used only when signed media URLs must differ from the private S3 endpoint
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=cineforge
S3_ACCESS_KEY=cineforge
S3_SECRET_KEY=change-me-in-production
S3_FORCE_PATH_STYLE=true

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Worker safety
WORKER_CONCURRENCY=2
MAX_AUTO_RETRIES=2
QC_RETRY_THRESHOLD=75
QC_FLAG_THRESHOLD=90
