{
  "name": "cineforge-ai-movie-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Autonomous AI movie studio powered by OpenAI Responses API and Google Gemini video models.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker": "tsx src/server/worker/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1116.0",
    "@aws-sdk/s3-request-presigner": "3.1116.0",
    "@google/genai": "2.18.0",
    "bullmq": "6.2.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "framer-motion": "12.23.24",
    "lucide-react": "1.33.0",
    "next": "16.3.2",
    "openai": "7.5.0",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
