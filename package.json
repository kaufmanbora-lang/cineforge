{
  "name": "cineforge-ai-movie-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "author": "CineForge",
  "description": "Autonomous AI movie studio powered by OpenAI Responses API and Google Gemini video models.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker": "tsx src/server/worker/index.ts",
    "desktop:runtime": "node scripts/prepare-standalone.mjs --desktop",
    "desktop:dev": "pnpm build && electron .",
    "desktop:unpacked": "pnpm build && node scripts/prepare-standalone.mjs --desktop && electron-builder --win --x64 --dir",
    "desktop:build": "pnpm build && node scripts/prepare-standalone.mjs --desktop && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1116.0",
    "@aws-sdk/s3-request-presigner": "3.1116.0",
    "@google/genai": "2.18.0",
    "bullmq": "6.2.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "framer-motion": "12.23.24",
    "ioredis": "5.11.1",
    "lucide-react": "1.33.0",
    "next": "16.3.2",
    "openai": "7.5.0",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "4.1.11",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "build": {
    "appId": "com.cineforge.studio",
    "productName": "CineForge Studio",
    "executableName": "CineForge",
    "artifactName": "CineForge-Setup-${version}-${arch}.${ext}",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".desktop-runtime/server",
        "to": "server",
        "filter": [
          "**/*",
          "!node_modules/**/*"
        ]
      },
      {
        "from": ".desktop-runtime/server/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "public/cineforge-icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CineForge Studio",
      "uninstallDisplayName": "CineForge Studio",
      "deleteAppDataOnUninstall": false
    }
  }
}
